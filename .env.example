# ORACLE local development
PROJECT_NAME=ORACLE
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
OPENAI_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Database

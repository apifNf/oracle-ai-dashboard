# ORACLE local development
PROJECT_NAME=ORACLE
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auto-Trade lintas bursa (Workspace Configuration) ---
# ORACLE adalah SaaS PUBLIK NON-CUSTODIAL: kunci bursa dikirim per-request dari
# browser user (Settings -> Workspace Configuration) dan SELALU menang atas
# kredensial di bawah. Server tidak menyimpan kunci siapa pun.
#
# DEPLOYMENT PUBLIK: set false. Tanpa ini, user yang belum mengisi kuncinya akan
# diam-diam mengeksekusi order lewat akun bursa OPERATOR — uang Anda, trade dia.
# Biarkan true hanya untuk deployment single-tenant / dev pribadi.
EXCHANGE_ALLOW_SERVER_KEYS=true
#
# Kredensial fallback single-tenant (dipakai HANYA jika EXCHANGE_ALLOW_SERVER_KEYS
# true DAN user tidak mengirim kuncinya sendiri).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=            # passphrase (mis. OKX); kosongkan bila tidak perlu
# Fallback khusus Binance bila EXCHANGE_API_* kosong:
BINANCE_API_KEY=
BINANCE_API_SECRET=
# LIVE order dimatikan total secara default. WAJIB set true + confirm=true
# per request untuk mengirim order sungguhan. Diamkan false untuk dry-run.
TRADE_LIVE_ENABLED=false
# true = sandbox/testnet bursa (aman). Set false HANYA untuk live sungguhan.
EXCHANGE_TESTNET=true
DEFAULT_EXCHANGE_ID=binance
DEFAULT_MARKET_TYPE=spot

# Database
POSTGRES_USER=oracle
POSTGRES_PASSWORD=oracle
POSTGRES_DB=oracle
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://oracle:oracle@db:5432/oracle

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Monetisasi: Coinbase Commerce (PRODUCTION / GO-LIVE) ---
# Endpoint backend sudah mengarah ke production charges API
# (https://api.commerce.coinbase.com). Isi COINBASE_COMMERCE_API_KEY dengan
# LIVE API KEY dari dashboard Coinbase Commerce — BUKAN sandbox/test key.
# Ambil di: Coinbase Commerce -> Settings -> Security -> API keys.
# COINBASE_COMMERCE_WEBHOOK_SECRET juga dari dashboard (Webhook subscriptions),
# dipakai memverifikasi header X-CC-Webhook-Signature (HMAC-SHA256).
# Bila kedua nilai kosong, billing jatuh ke MOCK mode untuk dev lokal saja.
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
